[build-system]
requires = [ 'scikit-build-core', 'wheel' ]
build-backend = 'scikit_build_core.build'

[tool.scikit-build]
wheel.packages = ['carla']
cmake.version = '>=@CMAKE_MAJOR_VERSION@.@CMAKE_MINOR_VERSION@'
# The build type, generator and paths of the CARLA build come from the
# carla-python-api target's environment (SKBUILD_CMAKE_BUILD_TYPE,
# CMAKE_GENERATOR, SKBUILD_CMAKE_DEFINE), so builds for different Python
# versions can share this file.
ninja.version=">=1.10"
ninja.make-fallback=true

[project]
name = 'carla'
version = '@CARLA_VERSION@'
# The wheel's cpXY tag pins the interpreter it was built for.
requires-python = '>=3.8'
authors = [ { name = 'The CARLA team', email = 'carla.simulator@gmail.com' } ]
description = 'Python API for communicating with the CARLA server.'
readme = 'README.md'
license = { 'file' = 'LICENSE' }
keywords = [
  'simulator',
  'research',
  'ai',
  'computer-vision',
  'deep-learning',
  'cross-platform',
  'deep-reinforcement-learning',
  'artificial-intelligence',
  'ros',
  'self-driving-car',
  'ue4',
  'ue5',
  'autonomous-driving',
  'autonomous-vehicles',
  'imitation-learning',
  'unreal-engine-4',
  'unreal-engine-5',
  'carla',
  'carla-simulator'
]

[project.urls]
Homepage = 'https://carla.org/'
Documentation = 'https://carla.readthedocs.io/en/latest/'
Repository = 'https://github.com/carla-simulator/carla.git'
Issues = 'https://github.com/carla-simulator/carla/issues'
Changelog = 'https://github.com/carla-simulator/carla/blob/master/CHANGELOG.md'
