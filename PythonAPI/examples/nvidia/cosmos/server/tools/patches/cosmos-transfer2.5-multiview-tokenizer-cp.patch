+    # carla-cosmos patch (server/tools/patches/cosmos-transfer2.5-multiview-tokenizer-cp.patch): the tokenizer hands
+    # one view to each context-parallel rank; the pinned release raised when there were more views than ranks
+    # (7 views need 8 GPUs) and decode_cp would fail on the shape.  Do it in rounds of cp_size views instead: the
+    # same per-rank memory as NVIDIA's layout, any rank count (including a single GPU, where each round is one view).
+    def _tokenizer_cp(self):
+        """(cp_group, cp_size); (None, 1) when context parallelism is not initialised."""
+        try:
+            cp_group = parallel_state.get_context_parallel_group()
+            return cp_group, len(get_process_group_ranks(cp_group))
+        except (AssertionError, RuntimeError, ValueError):
+            return None, 1
+
+    def _tokenizer_cp_rounds(self, views_V_B_C_T_H_W: torch.Tensor, fn) -> torch.Tensor:
+        cp_group, cp_size = self._tokenizer_cp()
+        n_views = views_V_B_C_T_H_W.shape[0]
+        outputs = []
+        for start in range(0, n_views, cp_size):
+            chunk = views_V_B_C_T_H_W[start : start + cp_size]
+            if cp_group is None:
+                outputs.append(fn(rearrange(chunk, "V B C T H W -> (B V) C T H W")))
+                continue
+            padded = torch.zeros((cp_size, *chunk.shape[1:]), **self.tensor_kwargs)
+            padded[0 : chunk.shape[0]] = chunk
+            local_V_B_C_T_H_W = broadcast_split_tensor(padded, seq_dim=0, process_group=cp_group)
+            local_out = fn(rearrange(local_V_B_C_T_H_W, "V B C T H W -> (B V) C T H W"))
+            gathered = [torch.empty_like(local_out) for _ in range(cp_size)]
+            dist.all_gather(gathered, local_out, group=cp_group)
+            outputs.extend(gathered[0 : chunk.shape[0]])
+        return torch.cat(outputs, dim=2)  # [B, C, V * T, H, W]
+
