# A map's OpenDRIVE, Traffic Manager and navigation files are not assets: the
# cook ignores them and they ship only when their directory is listed in
# DirectoriesToAlwaysStageAsUFS. Derive that list from the cook scope, so a map
# anywhere under Content carries its own sidecars -- including the maps
# Util/Tools/Import.py writes to /Game/<package>/Maps/<Name>/, which no fixed
# Carla/Maps/... entry can reach.
#
# Inputs: CARLA_MAPS_TO_COOK (+-separated package paths), CARLA_UE_PROJECT_PATH,
# UE_SYSTEM_NAME. Writes Config/<Platform>/<Platform>Game.ini, which sits above
# DefaultGame.ini in the config hierarchy UAT reads when it stages.

function (carla_generate_cooked_map_staging MAPS_TO_COOK PROJECT_PATH SYSTEM_NAME)
  set (GENERATED_DIR ${PROJECT_PATH}/Config/${SYSTEM_NAME})
  set (GENERATED_INI ${GENERATED_DIR}/${SYSTEM_NAME}Game.ini)

  if ("${MAPS_TO_COOK}" STREQUAL "")
    # No explicit scope: UAT falls back to DefaultGame.ini's own MapsToCook
    # list, whose sidecars are covered by the static entries there.
    file (REMOVE ${GENERATED_INI})
    return ()
  endif ()

  string (REPLACE "+" ";" MAP_LIST "${MAPS_TO_COOK}")
  set (STAGE_LINES)
  set (SEEN)
  foreach (MAP_PACKAGE ${MAP_LIST})
    string (STRIP "${MAP_PACKAGE}" MAP_PACKAGE)
    if ("${MAP_PACKAGE}" STREQUAL "")
      continue ()
    endif ()
    # /Game/Carla/Maps/Twins/Eixample/Eixample -> Carla/Maps/Twins/Eixample
    string (REGEX REPLACE "^/Game/" "" MAP_RELATIVE "${MAP_PACKAGE}")
    string (REGEX REPLACE "/[^/]+$" "" MAP_DIR "${MAP_RELATIVE}")
    if ("${MAP_DIR}" STREQUAL "" OR "${MAP_DIR}" STREQUAL "${MAP_RELATIVE}")
      continue ()
    endif ()
    foreach (SIDECAR OpenDrive TM Nav)
      set (ENTRY "${MAP_DIR}/${SIDECAR}")
      if (NOT "${ENTRY}" IN_LIST SEEN)
        list (APPEND SEEN "${ENTRY}")
        # UAT skips an entry whose directory does not exist, so listing all
        # three per map costs nothing when a map has no navigation data.
        list (APPEND STAGE_LINES
          "+DirectoriesToAlwaysStageAsUFS=(Path=\"${ENTRY}\")")
      endif ()
    endforeach ()
  endforeach ()

  if (NOT STAGE_LINES)
    file (REMOVE ${GENERATED_INI})
    return ()
  endif ()

  string (REPLACE ";" "\n" STAGE_BLOCK "${STAGE_LINES}")
  file (MAKE_DIRECTORY ${GENERATED_DIR})
  file (WRITE ${GENERATED_INI}
"; Generated by CMake from CARLA_MAPS_TO_COOK -- do not edit.
; One entry per cooked map's sidecar directories, so the OpenDRIVE, Traffic
; Manager and navigation files of exactly the maps being cooked are staged.

[/Script/UnrealEd.ProjectPackagingSettings]
${STAGE_BLOCK}
")
  list (LENGTH SEEN SEEN_COUNT)
  carla_message ("package: staging ${SEEN_COUNT} sidecar directories for the cooked maps")
endfunction ()
